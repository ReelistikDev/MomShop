# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# DB connection string — used only by scripts/db-migrate.mjs (not on Vercel)
SUPABASE_DB_URL=

# --- Admin dashboard ---
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=
APP_URL=
ADMIN_EMAIL=

# --- Square (checkout / payments) ---
# Server-only secret access token (Square Developer Dashboard → Credentials).
SQUARE_ACCESS_TOKEN=
# "production" (default) or "sandbox". Controls the server SDK endpoint.
SQUARE_ENVIRONMENT=production
# Public values used by the in-browser Web Payments SDK (safe to expose).
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# "production" (default) or "sandbox" — selects the web.squarecdn.com SDK URL.
NEXT_PUBLIC_SQUARE_ENVIRONMENT=production
