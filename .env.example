# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# DB connection string — used only by scripts/db-migrate.mjs (not on Vercel)
SUPABASE_DB_URL=

# --- Admin dashboard ---
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=
APP_URL=
ADMIN_EMAIL=

# --- Square (hosted checkout / payment links) ---
# Server-only secret access token (Square Developer Dashboard → Credentials).
SQUARE_ACCESS_TOKEN=
# "production" (default) or "sandbox". Controls the server SDK endpoint.
SQUARE_ENVIRONMENT=production
# Square location to attribute orders to.
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# Webhook signature key (Square Dashboard → Webhooks → your subscription).
# Subscribe to "payment.updated" and point it at {APP_URL}/api/square/webhook.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# APP_URL (set above) must be the absolute site URL — used for the post-payment
# redirect and to verify webhook signatures.
